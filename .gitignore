# Sound 2.0 (SOUND_UPGRADE §5.3, §14.4)
tools/audio/.cache
audio-review

# Blender scratch frames and contact sheets (tools/blender/ranch_scenes.py); the encoded clips live in public/baked/scenes/
tools/blender/out/

# Art 2.0 (docs/ART_2_PLAN.md): the owner's concept pictures (reference only, never shipped) and the in-game review sheets
concept/
art-review/

# Art 2.1 Performance check: the UASTC normal maps are a local comparison only (too large for the download cap; ART_2_DETAIL §3.3)
public/models/perf/*_normal.ktx2

# Arenas (tools/blender/arenas/): the downloaded CC0 Poly Haven sources (fetch.py), never committed
tools/blender/arenas/.cache/
tools/blender/arenas/__pycache__/

# Art 2.1 Ultra (tools/art/ultra.ts): the game loads only <breed>.glb, <breed>.lite.glb (the Lite copy) and
# <breed>.json; the separate textures and the WebP copy are local comparisons, rebuilt by `npm run art:ultra` (the Lite
# copy's own textures stay in tools/blender/out/<breed>-ultra/ship/lite/)
public/models/monsters-ultra/*.webp
public/models/monsters-ultra/*_*.ktx2
public/models/monsters-ultra/*.webp.glb
!public/models/monsters-ultra/*.lite.glb

# Python caches (Blender scripts)
__pycache__/
